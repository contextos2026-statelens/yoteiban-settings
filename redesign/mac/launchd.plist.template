<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh が見張り番用と時計用の2つの plist を生成する。鍵はenvファイルから読み込む。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>{LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string><string>-c</string>
    <string>set -a; . "{HOME}/yoteiban-watch/env"; set +a; cd "{HOME}/yoteiban-watch/app" &amp;&amp; exec {PY} -m yoteiban_watch.run --config "{HOME}/yoteiban-watch/config.json" {MODE_ARG}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>{HOME}/yoteiban-watch/state/{LOG_NAME}.out</string>
  <key>StandardErrorPath</key><string>{HOME}/yoteiban-watch/state/{LOG_NAME}.err</string>
</dict>
</plist>
